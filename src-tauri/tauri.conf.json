{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Start",
  "version": "0.1.0",
  "identifier": "com.aistart.toolbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:16271",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Start · 开发工具与模型管理",
        "width": 1400,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "AI Start",
    "copyright": "Copyright (c) 2026 AI Start",
    "homepage": "https://github.com/2507483326/aiStart",
    "category": "DeveloperTool",
    "shortDescription": "管理开发者工具的桌面工具箱",
    "longDescription": "一键安装、一键更新、一键把任意模型接入桌面客户端。内置只监听 127.0.0.1 的本地网关，在 Anthropic Messages 与 OpenAI 两种协议之间双向翻译。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "5f99eafa-a6b0-548a-b8dd-62f1d31f5c09",
        "language": "zh-CN"
      }
    }
  }
}
